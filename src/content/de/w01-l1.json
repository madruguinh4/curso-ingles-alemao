      "explanation": "Ich + heiße + nome."
    },
    {
      "type": "learn",
      "text": "Wie heißt du?",
      "translation": "Como você se chama?",
      "rule": "du = você, para amigos, família e colegas."
    },
    {
      "id": "de-w01-l1-g3",
      "type": "gap",
      "skill": "writing",
      "prompt": "Wie ___ du?",
