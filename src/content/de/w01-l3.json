    },
    {
      "type": "learn",
      "text": "Gute Nacht!",
      "translation": "Boa noite! (só ao ir dormir)",
      "rule": "Gute Nacht é só para se despedir à noite.",
      "avoid": {
        "wrong": "Gute Nacht, Frau Weber! (ao chegar)",
        "right": "Guten Abend, Frau Weber!"
      }
    },
    {
      "id": "de-w01-l3-g1",
      "type": "choice",
      "skill": "reading",
      "prompt": "Consultório, 9h da manhã. O que dizer?",
