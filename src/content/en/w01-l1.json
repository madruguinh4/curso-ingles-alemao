          "translation": "Prazer também. Eu sou do Brasil."
        },
        {
          "speaker": "Tom",
          "text": "Cool! See you later!",
          "translation": "Legal! Até mais!"
        },
        {
          "speaker": "Ana",
          "text": "Bye, Tom!",
          "translation": "Tchau, Tom!"
        }
      ]
    },
