  "language": "en",
  "title": "Olá! Eu sou…",
  "objective": "Dizer oi, seu nome e tchau.",
  "steps": [
    {
      "type": "learn",
      "text": "Hi! I'm Tom.",
      "translation": "Oi! Eu sou o Tom.",
      "rule": "Eu sou = I'm"
    },
    {
      "id": "en-w01-l1-g1",
      "type": "choice",
      "skill": "reading",
      "prompt": "Qual está certo?",
      "options": [
        "I Ana.",
        "I'm Ana.",
        "Am Ana."
      ],
      "answer": 1,
      "explanation": "Em inglês o \"sou\" não some: I'm Ana."
    },
    {
      "type": "learn",
      "text": "Hello! I'm Ana.",
      "translation": "Olá! Eu sou a Ana.",
      "rule": "O h de hello é soprado, como um suspiro."
    },
    {
      "id": "en-w01-l1-g2",
      "type": "gap",
      "skill": "writing",
      "prompt": "Hello! I ___ Tom.",
      "answers": [
        "am",
        "'m"
      ],
      "explanation": "Eu sou = I am (ou I'm)."
    },
    {
      "type": "learn",
      "text": "I am Tom.",
      "translation": "Eu sou o Tom.",
      "rule": "I am e I'm são iguais. Na conversa, use I'm."
    },
    {
      "id": "en-w01-l1-g3",
      "type": "transform",
      "skill": "writing",
      "prompt": "I am Tom.",
      "instruction": "Use a forma curta.",
      "answers": [
        "I'm Tom."
      ],
      "explanation": "I am → I'm."
    },
    {
      "type": "learn",
      "text": "Nice to meet you.",
      "translation": "Prazer em conhecer você.",
      "rule": "Só no primeiro encontro."
    },
    {
      "id": "en-w01-l1-g4",
      "type": "order",
      "skill": "writing",
      "prompt": "Monte: \"prazer em conhecer você\".",
      "tokens": [
        "Nice",
        "to",
        "meet",
        "you"
      ],
      "answer": "Nice to meet you",
      "explanation": "Decore inteira: Nice to meet you."
    },
    {
      "id": "en-w01-l1-g5",
      "type": "choice",
      "skill": "reading",
      "prompt": "2º encontro com o Tom. O que NÃO dizer?",
