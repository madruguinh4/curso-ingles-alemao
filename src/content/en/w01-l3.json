{
  "id": "en-w01-l3",
  "weekId": "en-w01",
  "language": "en",
  "title": "Formal e informal",
  "objective": "Cumprimentar do jeito certo: formal ou informal.",
  "steps": [
    {
      "type": "learn",
      "text": "Good morning!",
      "translation": "Bom dia!",
      "rule": "morning = manhã · afternoon = tarde · evening = noite, ao chegar"
    },
    {
      "type": "learn",
      "text": "Good night!",
      "translation": "Boa noite! (ao ir embora ou dormir)",
      "rule": "Good night é só para se despedir.",
      "avoid": {
        "wrong": "Good night, everyone! Let's start.",
        "right": "Good evening, everyone! Let's start."
      }
    },
    {
      "id": "en-w01-l3-g1",
      "type": "choice",
      "skill": "reading",
      "prompt": "15h, reunião. O que você diz?",
      "options": [
        "Good night.",
        "Good afternoon.",
        "Good morning."
      ],
      "answer": 1,
      "explanation": "À tarde: Good afternoon."
    },
    {
      "id": "en-w01-l3-g2",
      "type": "gap",
      "skill": "writing",
      "prompt": "Good ___! Sleep well.",
      "answers": [
        "night"
      ],
      "explanation": "Para dormir: Good night."
    },
    {
      "type": "learn",
      "text": "Good morning, Ms. Lee. How are you?",
      "translation": "Bom dia, Sra. Lee. Como vai?",
      "rule": "Formal: Mr. (homem) ou Ms. (mulher) + sobrenome.",
      "avoid": {
        "wrong": "Good morning, Mr. John.",
        "right": "Good morning, Mr. Smith."
      }
    },
    {
      "type": "learn",
      "text": "I'm fine, thank you. And you?",
      "translation": "Estou bem, obrigada. E você?"
    },
    {
      "id": "en-w01-l3-g3",
      "type": "gap",
      "skill": "writing",
      "prompt": "Good morning. How ___ you?",
      "answers": [
        "are"
      ],
      "explanation": "Como vai? = How are you?"
    },
    {
      "type": "learn",
      "text": "Hey, Ju! How's it going?",
      "translation": "Oi, Ju! Como vai?",
      "rule": "Informal: Hi ou Hey + primeiro nome."
    },
    {
      "id": "en-w01-l3-g4",
      "type": "choice",
      "skill": "reading",
      "prompt": "Qual é informal?",
      "options": [
        "Good evening, Mr. Smith.",
        "Hey, Tom! How's it going?",
        "How are you, Ms. Lee?"
      ],
      "answer": 1,
      "explanation": "Hey + primeiro nome = informal."
    },
    {
      "id": "en-w01-l3-g5",
      "type": "transform",
      "skill": "writing",
      "prompt": "You are welcome.",
      "instruction": "Use a forma curta.",
      "answers": [
        "You're welcome."
      ],
      "explanation": "You are → You're. Quer dizer \"de nada\"."
    },
    {
      "type": "dialogue",
      "lines": [
        {
          "speaker": "Receptionist",
          "text": "Good morning. How are you today?",
          "translation": "Bom dia. Como vai hoje?"
        },
        {
          "speaker": "Ana",
          "text": "I'm fine, thank you. And you?",
          "translation": "Estou bem, obrigada. E você?"
        },
        {
          "speaker": "Receptionist",
          "text": "Very well, thanks. Welcome!",
          "translation": "Muito bem, obrigado. Bem-vinda!"
        },
        {
          "speaker": "Ana",
          "text": "Thanks! … Hey, Ju! How's it going?",
          "translation": "Obrigada! … Oi, Ju! Como vai?"
        },
        {
          "speaker": "Ju",
          "text": "Hey, Ana! I'm good. You?",
          "translation": "Oi, Ana! Tudo bem. E você?"
        },
        {
          "speaker": "Ana",
          "text": "Great! See you!",
          "translation": "Ótima! Até!"
        }
      ]
    },
    {
      "id": "en-w01-l3-g6",
      "type": "dictation",
      "skill": "listening",
      "text": "Good evening, Ms. Lee. How are you?",
      "answers": [
        "Good evening, Ms. Lee. How are you?",
        "Good evening, Ms Lee. How are you?"
      ],
      "explanation": "Ms. soa \"miz\".",
      "lang": "en"
    }
  ],
  "production": {
    "id": "en-w01-l3-p",
    "type": "free",
    "skill": "writing",
    "prompt": "Escreva um oi formal para Ms. Lee e um informal para o amigo Ju.",
    "model": "Good morning, Ms. Lee. How are you today?\n\nHey Ju! How's it going?",
    "checklist": [
      "Formal: Good morning/afternoon + Ms. Lee",
      "Informal: Hi ou Hey + Ju",
      "Não usei Good night para cumprimentar"
    ]
  },
